# --- Store ---
PORT=4000
SITE_NAME=POLYMATH DATA HUB
MARKUP_PERCENT=15
GUEST_MARKUP_PERCENT=55
# Currency label shown in the UI
CURRENCY=GHS
# OTP delivery. 1 = log the code to the server journal and show it in the UI
# (testing only). 0 = send for real via WhatsApp Cloud API, then SMS fallback.
OTP_MOCK=1
# Never return the code to the browser in production (owner reads it from
# `journalctl -u idatastore | grep "WhatsApp mock"`). Set 1 for local dev only.
OTP_MOCK_EXPOSE=0
# Google OAuth for customer sign-in (second option alongside phone/WhatsApp)
# Create at https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web)
# Authorized redirect URI: https://bundles.example.com/api/auth/google/callback
#GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-xxx
#
# --- WhatsApp Cloud API (OTP channel, preferred) ---
# Setup: https://developers.facebook.com -> My Apps -> Create App -> Business
#   -> add product "WhatsApp" -> API Setup. Copy the Test access token + Phone
#   number ID. For production, create a System User token with
#   whatsapp_business_messaging + whatsapp_business_management.
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_ID=
# App secret (App settings -> Basic) — required to verify webhook signatures.
#WHATSAPP_APP_SECRET=
# Any string you invent; paste the same value in the Meta webhook "Verify token".
#WHATSAPP_VERIFY_TOKEN=
# Graph API version. v20.0 expired 2026-09-24; v25.0 is current + supported.
WHATSAPP_API_VERSION=
# Authenticated template. Meta requires an APPROVED template for business-initiated
# messages; free-form text only works with Meta's test number. Create the template
# in WhatsApp -> Message Templates, category "Authentication", body:
#   Your POLYMATH DATA HUB code is {{1}}. Valid for 5 minutes.
# Leave blank only while using Meta's test number.
#WHATSAPP_OTP_TEMPLATE=
#WHATSAPP_OTP_LANG=
# Webhook to register in Meta (must be public HTTPS):
#   https://bundles.example.com/api/whatsapp/webhook
# subscribe to: messages + message template status updates
#
# --- SMS fallback (optional) ---
# Arkesel (Ghana) — free account gives 10 test SMS. Cheapest flat rate ~GHS 0.02.
# https://developers.arkesel.com -> API Key
#ARKESEL_API_KEY=xxx
#ARKESEL_SENDER=POLYMATH
# Africa's Talking
#AT_USERNAME=xxx
#AT_API_KEY=xxx
#AT_SENDER_ID=xxx
CONTACT_PHONE=
CONTACT_LOCATION=
REFERRAL_CREDIT=2
# Safety net, not a pricing decision: a price is never allowed below supplier cost +
# this percent, whatever a promo, a pinned price or a supplier price rise does. Set 0
# to turn the floor off. A value saved in the Pricing tab overrides this.
MIN_MARGIN_PERCENT=5
# Shown in /.well-known/security.txt so a researcher can reach you. Leave blank and
# the file is not served at all (better than publishing a placeholder address).
# Examples: mailto:security@yourdomain.com  https://yourdomain.com/security
SECURITY_CONTACT=
#Optional: when this file should be considered stale (RFC 9116 says < 1 year)
#SECURITY_EXPIRES=2027-09-30T00:00:00.000Z
#SECURITY_LANGUAGES=en
TOPUP_BONUS_PERCENT=0
TOPUP_BONUS_THRESHOLD=100

# --- Admin (protects /admin and /api/admin/*) ---
# REQUIRED. No default creds: if unset, admin refuses login (503).
ADMIN_USER=change-me
ADMIN_PASS=change-me-to-a-long-random-string

# --- iDATA reseller API (paste values from your idatagh.com member area) ---
# Docs: https://idatagh.com -> member "API Access"
IDATAGH_API_URL=https://idatagh.com/wp-json/custom/v1
IDATAGH_API_KEY=tera_live_xxx
# How the key is sent: header|bearer|query|json
IDATAGH_AUTH_MODE=bearer
# 1 = serve fake products and pretend orders are delivered, WITHOUT touching the
# supplier. Development only: a customer who pays gets "Delivered" and no data.
# Leave this at 0. Anything other than exactly 1 (including unset) is a live site,
# so a missing variable can never turn a real storefront into a fake one.
IDATAGH_USE_MOCK=0
# Catalog is fetched once per network (requested in the path via {network})
IDATAGH_NETWORKS=mtn,telecel,airteltigo
IDATAGH_PATH_PRODUCTS=packages?network={network}
IDATAGH_PATH_BUY=place-order
IDATAGH_PATH_WALLET=wallet-balance
IDATAGH_PATH_WEBHOOK=webhook-settings
# Map idatagh package JSON fields -> our model. Values are the JSON keys.
# Common fields: id, name, price, size_mb, validity, network
IDATAGH_FIELD_ID=package_id
IDATAGH_FIELD_LABEL=label
IDATAGH_FIELD_NAME=label
IDATAGH_FIELD_PRICE=price
IDATAGH_FIELD_SIZE=data_size
IDATAGH_FIELD_VALIDITY=
IDATAGH_FIELD_NETWORK=network
# 1 = the SIZE field is in GB (idatagh data_size); 0 = already MB
IDATAGH_SIZE_GB=1
# idatagh place-order request body fields
IDATAGH_BUY_PHONE=
IDATAGH_BUY_PLAN=pa_data-bundle-packages
IDATAGH_BUY_NETWORK=network
IDATAGH_BUY_REFERENCE=
# Catalog cache lifetime in ms (default 600000 = 10 min)
IDATAGH_CACHE_TTL_MS=600000
# Webhook secret, returned by the /webhook-settings API the first time a URL is
# saved. Used to HMAC-verify X-Tera-Signature on POST /api/idatagh/webhook.
# Webhook URL to set at idatagh: https://bundle.example.com/api/idatagh/webhook
IDATAGH_WEBHOOK_SECRET=

# --- Paystack (optional; leave blank for manual-payment order flow) ---
#PAYSTACK_SECRET_KEY=sk_live_xxx
#PAYSTACK_PUBLIC_KEY=pk_live_xxx

# --- Payments/settlement details shown to customers when Paystack is off ---
DEFAULT_PAY_NOTE=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
# Canonical public origin. Drives five customer-facing things: the Paystack redirect,
# <link rel=canonical>, og:url, the og:image/twitter:image that WhatsApp and Facebook
# render when someone shares a link, and the URLs in sitemap.xml and robots.txt.
# The pages ship with https://bundles.example.com baked in; at serve time the server
# swaps that placeholder for whatever you set here. Set the real domain, or the
# placeholder is what gets shared and indexed.
PUBLIC_BASE_URL=https://bundle.example.com
# --- Supplier risk controls (optional) ---
# Warn in the admin dashboard when the iDATA balance is low or unreachable.
SUPPLIER_LOW_GHS=50
